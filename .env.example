# Copy to .env.local and fill in when ready. Nothing below is required to
# run the app locally — every value has a safe placeholder default in code.
# See docs/attribution.md for what these are for and how to go live.

# Shared secret for verifying BOTH inbound webhooks (booking outcomes AND
# cruise-catalogue changes — see src/app/api/webhooks/boatlocal-booking and
# src/app/api/webhooks/boatlocal-cruise). Generate a real one with
# `openssl rand -hex 32` and give the SAME value to BoatLocal's team when the
# webhooks go live — never commit the real value.
BOATLOCAL_WEBHOOK_SECRET=

# BoatLocal's public API host — overridable for a future staging/test target
# (e.g. test.boatlocal.nl). Used by reconcileBoatLocalCatalog
# (src/lib/data/source.ts) to hit `${this}/api/public/cruises` on a daily
# cron. Defaults to https://boatlocal.nl when unset.
BOATLOCAL_CATALOG_BASE_URL=https://boatlocal.nl

# Shared secret for the daily catalogue-reconciliation cron
# (src/app/api/cron/sync-boat-tours). Vercel sends
# `Authorization: Bearer <this>` automatically on its own invocations once
# this is set — see vercel.json's `crons` entry and that route's own comment.
CRON_SECRET=

# Admin bootstrap allowlist (src/lib/admin/devAuth.ts). This creates the first
# Staff accounts before anyone can reach Admin > Users. Once Staff can sign in,
# additional Staff accounts should be issued through the user-invite flow; an
# existing role='admin' profile remains authorized without being added here.
# Empty/unset means only already-invited/existing Staff can sign in.
ADMIN_ALLOWED_EMAILS=admin@boatlocal.nl
# --- Email (Resend) -------------------------------------------------------
# Transactional email: company-owner invites, guide invites. Server-only —
# never prefix with NEXT_PUBLIC_. Create the key in Resend with "Sending
# access" scope only, not Full access.
RESEND_API_KEY=

# Verified sender. The domain here must be verified in Resend (DKIM/SPF),
# and must match the DKIM signing domain or DMARC alignment fails.
RESEND_FROM=Map App <mail@map.boatlocal.nl>

# Where replies actually go. RESEND_FROM is not necessarily a real mailbox,
# so this must be one that a human reads — invite emails do get replies.
RESEND_REPLY_TO=

# Absolute base URL used to build invite links inside emails. Deliberately
# NOT derived from currentOrigin() (src/lib/studio/requestOrigin.ts): that
# reads the client-supplied Host header, which is fine for a QR code but is
# a phishing vector in an email — a spoofed Host would send a real invite
# to a real owner pointing at an attacker's domain.
APP_BASE_URL=http://localhost:3000
