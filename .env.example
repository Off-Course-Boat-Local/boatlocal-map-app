# Copy to .env.local and fill in when ready. Nothing below is required to
# run the app locally — every value has a safe placeholder default in code.
# See docs/attribution.md for what these are for and how to go live.

# The boatlocal.nl booking page guests are redirected to. Placeholder until
# BoatLocal's team confirms the real param names — see docs/attribution.md.
NEXT_PUBLIC_BOOKING_BASE_URL=https://boatlocal.nl/book

# Shared secret for verifying the inbound booking webhook. Generate a real
# one with `openssl rand -hex 32` and give the SAME value to BoatLocal's
# team when the webhook goes live — never commit the real value.
BOATLOCAL_WEBHOOK_SECRET=

# Admin sign-in allowlist (src/lib/admin/devAuth.ts). Admin has no invite
# system — it's Boat Local's own staff, not self-serve — so this is the
# only gate: a comma-separated list of email addresses. An allowlisted
# email's first successful magic-link verification creates their `profiles`
# row with role='admin'; anyone else is refused. Empty/unset means nobody
# can ever sign in to Admin (fail closed), so this must be set for real use.
ADMIN_ALLOWED_EMAILS=admin@boatlocal.nl
